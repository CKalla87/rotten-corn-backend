@baseUrl = http://localhost:5000
@urlPath = api/v1

### Upload profile image (base64)
POST {{baseUrl}}/{{urlPath}}/images/profile
Content-Type: application/json
Accept: application/json
withCredentials: true

{
  "image": "https://images.ctfassets.net/h6goo9gw1hh6/2sNZtFAWOdP1lmQ33VwRN3/24e953b920a9cd0ff2e1d587742a2472/1-intro-photo-final.jpg?w=1200&h=992&q=70&fm=webp"
}

### Upload background image (base64)
POST {{baseUrl}}/{{urlPath}}/images/background
Content-Type: application/json
Accept: application/json
withCredentials: true

{
  "image": "https://png.pngtree.com/thumb_back/fh260/background/20240913/pngtree-stunning-red-and-blue-smoke-images-for-download-image_16191211.jpg"
}

### Upload background image (existing Cloudinary URL)
POST {{baseUrl}}/{{urlPath}}/images/background
Content-Type: application/json
Accept: application/json
withCredentials: true

{
  "image": "https://png.pngtree.com/thumb_back/fh260/background/20240913/pngtree-stunning-red-and-blue-smoke-images-for-download-image_16191211.jpg"
}

### Delete profile image
DELETE {{baseUrl}}/{{urlPath}}/images/69191a86956341271e20cca1
Content-Type: application/json
Accept: application/json
withCredentials: true

### Delete background image
DELETE {{baseUrl}}/{{urlPath}}/images/background/cptthpvdy8omdr9fnuc0
Content-Type: application/json
Accept: application/json
withCredentials: true

### Get user images
GET {{baseUrl}}/{{urlPath}}/images/68fe95d024b9f7e7415cecec
Content-Type: application/json
Accept: application/json
withCredentials: true
