{
  "name": "rotten-corn-backend",
  "version": "1.0.0",
  "description": "This is the api for The Rotten Corn Horror App",
  "main": "app.js",
  "scripts": {
    "start": "NODE_ENV=production pm2 start ./build/src/app.js -i 5 --attach --watch | ./node_modules/.bin/bunyan",
    "stop": "pm2 stop all",
    "delete": "pm2 delete all",
    "dev": "nodemon -r tsconfig-paths/register src/app.ts | ./node_modules/.bin/bunyan",
    "lint:check": "eslint 'src/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' --fix",
    "prettier:check": "prettier --check 'src/**/*.{ts,json}'",
    "prettier:fix": "prettier --write 'src/**/*.{ts,json}'",
    "test": "jest --coverage=true -w=1 --forceExit --detectOpenHandles --watchAll=false",
    "build": "ttsc -p .",
    "seeds:dev": "tsx src/seed.ts",
    "seeds:prod": "npx ts-node ./build/src/seed.js",
    "redis:commander": "npx redis-commander",
    "postinstall": "node -e \"const fs=require('fs');const path=require('path');const file=path.join('node_modules','buffer-equal-constant-time','index.js');if(fs.existsSync(file)){let content=fs.readFileSync(file,'utf8');content=content.replace(/SlowBuffer\\.prototype\\.equal/g,'Buffer.prototype.equal');fs.writeFileSync(file,content);}\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CKalla87/rotten-corn-backend.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/CKalla87/rotten-corn-backend/issues"
  },
  "homepage": "https://github.com/CKalla87/rotten-corn-backend#readme",
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/bull": "^4.10.0",
    "@types/bunyan": "^1.8.8",
    "@types/compression": "^1.7.2",
    "@types/cookie-session": "^2.0.44",
    "@types/cors": "^2.8.13",
    "@types/ejs": "^3.1.5",
    "@types/express": "^4.17.17",
    "@types/express-status-monitor": "^1.3.3",
    "@types/hpp": "^0.2.2",
    "@types/ip": "^1.1.3",
    "@types/jsonwebtoken": "^9.0.1",
    "@types/lodash": "^4.14.191",
    "@types/nodemailer": "^6.4.14",
    "@types/redis-info": "^3.0.3",
    "@typescript-eslint/eslint-plugin": "^5.53.0",
    "@typescript-eslint/parser": "^5.53.0",
    "eslint": "^8.35.0",
    "eslint-config-prettier": "^8.6.0",
    "jest": "^29.7.0",
    "prettier": "^2.8.4",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^3.14.2",
    "tsx": "^4.20.6",
    "typescript": "^4.9.5"
  },
  "dependencies": {
    "@bull-board/express": "^5.0.0",
    "@bull-board/ui": "^5.0.0",
    "@faker-js/faker": "^9.0.0",
    "@jest/types": "^29.6.3",
    "@napi-rs/canvas": "^0.1.82",
    "@sendgrid/mail": "^8.1.0",
    "@socket.io/redis-adapter": "^8.1.0",
    "@types/jest": "^29.5.11",
    "@types/passport": "^1.0.17",
    "@types/passport-facebook": "^3.0.4",
    "@types/passport-github2": "^1.2.9",
    "@types/passport-google-oauth20": "^2.0.17",
    "axios": "^1.13.2",
    "bcryptjs": "^2.4.3",
    "bull": "^4.10.4",
    "bunyan": "^1.8.15",
    "cloudinary": "^1.34.0",
    "compression": "^1.7.4",
    "cookie-session": "^2.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "express-status-monitor": "^1.3.4",
    "helmet": "^6.0.1",
    "hpp": "^0.2.3",
    "http-status-codes": "^2.2.0",
    "ip": "^1.1.8",
    "joi": "^17.8.3",
    "jsonwebtoken": "^8.5.1",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "mongoose": "^6.10.0",
    "nodemailer": "^6.9.8",
    "passport": "^0.7.0",
    "passport-facebook": "^3.0.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
